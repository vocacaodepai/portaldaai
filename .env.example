# Chave de API do Pexels (https://www.pexels.com/api/)
# Fonte principal das imagens de capa dos artigos.
PEXELS_API_KEY=

# Chave de API do Pixabay (https://pixabay.com/api/docs/)
# Usada como segunda opção quando o Pexels não retorna resultado.
PIXABAY_API_KEY=

# Sem nenhuma das duas chaves, o site usa uma capa ilustrada gerada
# localmente (fallback) — ver components/CoverImage.tsx.

# Google AdSense (preencha só depois da aprovação da conta).
# ID do publisher, formato ca-pub-XXXXXXXXXXXXXXXX. Com ele definido o site
# passa a: incluir a meta google-adsense-account, mostrar o aviso de cookies
# (LGPD) e carregar o script de anúncios após o consentimento.
NEXT_PUBLIC_ADSENSE_CLIENT=

# IDs das unidades de anúncio criadas no painel (só números). Cada formato só
# renderiza quando o seu ID existir; sem ID, nada aparece (nada de caixa vazia).
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_RECTANGLE=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_ANCHOR=
